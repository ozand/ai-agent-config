        },
        "an/gemini-3-pro-image-2k-3x4": {
          "name": "Gemini 3 Pro Image 2K 3x4"
        },
        "an/gemini-3-pro-image-2k-4x3": {
          "name": "Gemini 3 Pro Image 2K 4x3"
        },
        "an/gemini-3-pro-image-2k-9x16": {
          "name": "Gemini 3 Pro Image 2K 9x16"
        },
        "an/gemini-3-pro-image-3x4": {
