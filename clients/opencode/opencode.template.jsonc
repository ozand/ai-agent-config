          "name": "Gemini 3 Pro Image 2K 16x9"
        },
        "an/gemini-3-pro-image-2k-1x1": {
          "name": "Gemini 3 Pro Image 2K 1x1"
        },
        "an/gemini-3-pro-image-2k-21x9": {
