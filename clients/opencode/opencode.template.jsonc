        },
        "an/claude-opus-4-6": {
          "name": "Claude Opus 4.6"
        },
        "an/claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 3.0,
            "output": 15.0,
            "cache_read": 0.3,
            "cache_write": 3.75
          }
        },
        "an/gemini-3-pro-image": {
          "name": "Gemini 3 Pro Image"
        },
        "an/gemini-3-pro-image-16x9": {
          "name": "Gemini 3 Pro Image 16x9"
        },
        "an/gemini-3-pro-image-1x1": {
