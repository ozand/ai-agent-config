{
  "defaultProvider": "litellm-edge",
  "defaultModel": "cl/gpt-6-luna",
  "defaultThinkingLevel": "low",
  "enabledModels": [
    "cl/*",
    "an/*",
    "un/gpt-oss-20b-GGUF",
    "un/qwen3.8-27b-gguf"
  ],
  "packages": [
    "npm:context-mode@1.0.169",
    "npm:pi-subagents@0.50.0",
    "npm:pi-interactive-shell@0.15.0",
    "npm:pi-intercom@0.10.1",
    "https://github.com/nicobailon/pi-powerline-footer"
  ],
  "theme": "dark",
  "powerline": {
    "preset": "default"
  },
  "quietStartup": true,
  "hideThinkingBlock": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "transport": "auto",
  "httpIdleTimeoutMs": 300000,
  "websocketConnectTimeoutMs": 15000,
  "sessionDir": ".pi/sessions",
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "litellm-edge/cl/gpt-6-luna"
      },
      "researcher": {
        "model": "litellm-edge/an/gemini-3.1-pro-high"
      },
      "oracle": {
        "model": "litellm-edge/cl/gpt-6.1-sol",
        "thinking": "high"
      },
      "worker": {
        "model": "litellm-edge/cl/gpt-6-luna"
      },
      "reviewer": {
        "model": "litellm-edge/cl/gpt-6-luna",
        "thinking": "high"
      },
      "delegate": {
        "model": "litellm-edge/an/gemini-3.8-flash-high"
      }
    }
  },
  "tuiMode": "regular"
}
